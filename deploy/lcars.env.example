# Copied to ~/.config/lcars/env by deploy/install.sh; edit there (it holds the
# token and the code, so it stays mode 600 and out of git). Every setting is
# in app/config.py.

# Home Assistant: the Panel user's long-lived token (home-assistant's
# scripts/setup makes it). Empty: the panel shows NO TOKEN.
HA_URL=https://homeassistant.brick.nozdormu.cloud
HA_TOKEN=
# The code that opens climate control. Empty: only Home Assistant can open it
# (input_select.lcars_panel_lock: unlocked).
LCARS_PIN=
LCARS_THERMOSTAT=climate.thermostat
# Show the thermostat but never change it: no climate control or keypad.
LCARS_READ_ONLY=false

# The room's own sensor: an SHT3x (SHT30/31/35) on the Pi's I2C bus (pins 1,
# 3, 5, 6, or a Qwiic SHIM). OFFSET corrects the Pi's warmth, in °F: compare
# with a thermometer once (negative when it reads high).
LCARS_ROOM_SENSOR=false
LCARS_ROOM_NAME=ROOM
LCARS_ROOM_I2C_ADDRESS=0x44
LCARS_ROOM_OFFSET=0

# Weather for "lat,lon" (US: the National Weather Service, with Open-Meteo and
# MET Norway as backups). Empty: no weather. Here, not in git: it's where the
# panel is.
LCARS_WEATHER_POINT=

# Home Assistant entities for the extra screens and rows (empty turns each
# off): the internet's NETWORK row, the SHOPPING list (taps tick items off),
# and the PS5 (the console, and the game last played).
LCARS_WAN_ENTITY=binary_sensor.verizon_router_wan_status
LCARS_SHOPPING_LIST=todo.shopping_list
LCARS_MEDIA_PLAYER=media_player.playstation_5
LCARS_MEDIA_IMAGE=image.living_room_ps5_pw_now_playing

# The homelab's own pages (empty turns each off): ALERTS reads Prometheus'
# firing alerts and overwatch's state; WIGLE reads wigle-console's status.
LCARS_PROMETHEUS_URL=https://prometheus.brick.nozdormu.cloud
LCARS_OVERWATCH_URL=https://overwatch.brick.nozdormu.cloud
LCARS_WIGLE_URL=https://wigle.brick.nozdormu.cloud

# Overnight the panel is dark and silent; a tap wakes it, dimmed, for a minute.
# Either end may be "sunset" or "sunrise" (from Home Assistant), e.g.
# sunset-sunrise or 21:00-sunrise.
LCARS_NIGHT=21:00-07:00
LCARS_NIGHT_LEVEL=0.08
LCARS_DAY_LEVEL=1.0
LCARS_WAKE_SECONDS=60
LCARS_SOUND=false
# Everything drawn, times this (1.0: stock LCARS colours; 0.8: a fifth darker).
LCARS_COLOUR_LEVEL=1.0

# Branch brick1982 deploys from GitHub (deploy/deploy). Point it at a branch
# to try that on the real screen; set it back to master after merging.
LCARS_DEPLOY_BRANCH=master
