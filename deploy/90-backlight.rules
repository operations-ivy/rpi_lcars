# Installed to /etc/udev/rules.d/ by deploy/install.sh (the same rule brick-cicd-config installed): lets the video group (zaphod)
# set the 7" panel's brightness, so the panel can dim it overnight.
SUBSYSTEM=="backlight", ACTION=="add", RUN+="/bin/chgrp video /sys%p/brightness", RUN+="/bin/chmod g+w /sys%p/brightness"
