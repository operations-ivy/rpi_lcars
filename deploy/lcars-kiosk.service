# System unit: installed to /etc/systemd/system/ by deploy/install.sh. cage (a
# single-window Wayland compositor) shows the panel full screen on the 7" DSI
# panel, on tty1 in place of the login prompt. It replaces brick-arena's
# brick-kiosk.service (brick-cicd-config).
[Unit]
Description=LCARS panel (cage + pygame) on tty1
After=systemd-user-sessions.service plymouth-quit-wait.service network-online.target
Conflicts=getty@tty1.service brick-kiosk.service
After=getty@tty1.service

[Service]
User=zaphod
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland SDL_VIDEODRIVER=wayland LCARS_FULLSCREEN=true PYTHONUNBUFFERED=1
# A transparent cursor theme (deploy/blank-cursors): the touchscreen counts as
# a pointer, so cage would otherwise draw an arrow on the panel.
Environment=XCURSOR_PATH=/usr/local/share/lcars/cursors XCURSOR_THEME=default
EnvironmentFile=-/home/zaphod/.config/lcars/env
ExecStart=/usr/bin/cage -d -- /usr/bin/python3 /home/zaphod/rpi_lcars/app/lcars.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
